<!DOCTYPE html>
<html>

<head>
    <style type="text/css">
    </style>

    <title>Template Preview - {{template_id}}</title>
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">

    <script src="/jquery/jquery.min.js"></script>
    <script src="/handlebars/handlebars.min.js"></script>
    <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
</head>

<body>

    <div class="container-xxl pt-3">
        <div id="carouselTemplatePreview" class="carousel slide" data-bs-ride="carousel">
            {{#if file_names_without_default}}
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#carouselTemplatePreview" data-bs-slide-to="0" class="active" aria-current="true" aria-label="DEFAULT"></button>
                {{#each file_names_without_default}}
                <button type="button" data-bs-target="#carouselTemplatePreview" data-bs-slide-to="{{counter @index}}" aria-label="{{this}}"></button>
                {{/each}}
            </div>
            {{/if}}
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="/{{template_id}}/{{template_id}}-DEFAULT.bmp" class="d-block w-100">
                    {{#if file_names_without_default.length}}
                    {{#if is_lcd}}
                    <div class="carousel-caption d-none d-md-block">
                        <h5>DEFAULT</h5>
                    </div>
                    {{/if}}
                    {{/if}}
                </div>
                {{#each file_names_without_default}}
                <div class="carousel-item">
                    <img src="/{{../template_id}}/{{../template_id}}-{{this}}.bmp" class="d-block w-100">
                    {{#if ../is_lcd}}
                    <div class="carousel-caption d-none d-md-block">
                        <h5>{{this}}</h5>
                    </div>
                    {{/if}}
                </div>
                {{/each}}
            </div>
            {{#if file_names_without_default}}
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselTemplatePreview" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselTemplatePreview" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
            {{/if}}
        </div>
    </div>

</body>

</html>
