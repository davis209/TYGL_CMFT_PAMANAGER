<!DOCTYPE html>
<html>

<head>
    <style type="text/css">
        {{#if is_lcd}}
            img{
                height: 94vh;
            }
        {{/if}}
        {{#if is_led}}
            img{
                width: 99vw;
            }
        {{/if}}
    </style>

    <title>Template Preview - {{template_id}}</title>
    <link rel="shortcut icon" href="/favicon.ico">

    <script src="/jquery/jquery.min.js"></script>
    <script src="/handlebars/handlebars.min.js"></script>
</head>

<body>

    <div class="container-fluid">
        <div class="picture-area">
            <img id="show-picture" src="{{default_picture}}">
        </div>

        <div class="file-names-area">
            <select id="file-names">
                {{#each file_names}}
                <option value="{{this}}">{{this}}</option>
                {{/each}}
            </select>
        </div>
    </div>

    <script id="template" type="text/x-handlebars-template">
        var index = 0;
        var file_names = `{{file_names}}`.split(',');

        $('#file-names').change((event) => {
            $('#show-picture').attr('src', `/{{template_id}}/{{template_id}}-${event.target.value}.bmp`);
            index = file_names.indexOf(event.target.value);
        });

        $(document).keypress((event) => {
            if (event.key == 'Enter' || event.key == ' ') {
                index += 1;
                if (index == file_names.length) {
                    index = 0;
                }
                $('#file-names').val(file_names[index]).change();
            }
        });

        $('#file-names').val('DEFAULT').change();
    </script>

    <script>
        let source = $('#template').html();
        let template = Handlebars.compile(source);
        eval(template());
    </script>

</body>

</html>
